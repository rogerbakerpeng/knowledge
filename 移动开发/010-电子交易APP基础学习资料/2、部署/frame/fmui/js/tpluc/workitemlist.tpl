
<div class="em-timeline-item mui-clearfix {{active}}">
	<div class="em-timeline-date">{{operationdate}}</div>
	<div class="em-timeline-inner">
		<div class="em-timeline-node">
			<i class="mui-icon {{checkmarkempty}}"></i>
		</div>
		<div class="em-timeline-panel">
			<span class="em-timeline-title">{{activityname}}</span> <span class="em-timeline-content" style="padding-left: 0px;">
				<div class="em-table-view-cell">
					<span class="timeline_title">办理人员</span> <span class="timeline_name">{{transactorname}}</span>
				</div>
				<div class="em-table-view-cell {{hidden}}">
					<span class="timeline_title">办理意见</span> <span class="timeline_name">{{{opinion}}}</span>
				</div>
			</span>
		</div>
	</div>
</div>
