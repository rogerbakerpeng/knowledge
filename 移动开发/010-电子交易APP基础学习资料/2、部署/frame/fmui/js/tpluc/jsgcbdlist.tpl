{{#bdinfo}}
	<ul class="mui-table-view base-info">
		<div class="base-info-div">
			<li class="mui-table-view-cell baseinfo-li" name="biaoduanno">
				<span class="tit iconnum" >标的编号</span>
				<span class="con serial">{{{biaoduanno}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="biaoduanname">
				<span class="tit iconname">标的名称</span>
				<span class="con ">{{{biaoduanname}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="yjfs">
				<span class="tit iconway">交易方式</span>
				<span class="con ">{{{zhaobiaofangshi}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="htgs">
				<span class="tit iconmoney">合同估算价(万元)</span>
				<span class="con number format2">{{{touzigusuan}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="cqjy">
				<span class="tit iconmoney">挂牌价格(万元)</span>
				<span class="con number format2">{{{guapaiprice}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="cgys">
				<span class="tit iconmoney">预算金额(万元)</span>
				<span class="con number format2">{{{touzigusuan}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="cgfs">
				<span class="tit iconway">采购方式</span>
				<span class="con ">{{{zhaobiaofangshi}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="pgj">
				<span class="tit iconmoney">评估价格(万元)</span>
				<span class="con number format2">{{{zichantotal}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="bdfirsttype">
				<span class="tit iconname">污染物种类</span>
				<span class="con ">{{{bdfirsttype}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="biaoshuprice">
				<span class="tit iconname">交易数量(吨)</span>
				<span class="con format2">{{{biaoshuprice}}}</span>
			</li>
			<li class="mui-table-view-cell baseinfo-li"  name="touzigusuan">
				<span class="tit iconmoney">挂牌价格(元/吨*年)</span>
				<span class="con number format2">{{{touzigusuan}}}</span>
			</li>
		</div>
	</ul>
{{/bdinfo}}